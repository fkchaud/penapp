{
  "expo": {
    "name": "PenApp",
    "slug": "PenApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon-semin.png",
    "scheme": "penapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.semi.penapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon-semin.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.semi.penapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-semin.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e6f5d136-db55-49db-aa4c-28d99a0ec13b"
      }
    }
  }
}
